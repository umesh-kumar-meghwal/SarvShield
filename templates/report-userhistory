<h3 class="mb-4 text-base font-semibold">Report History</h3>

{% if reports %}
<div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead class="bg-white/5 text-mute">
            <tr>
                <th class="px-3 py-2 font-semibold">Phone</th>
                <th class="px-3 py-2 font-semibold">Link</th>
                <th class="px-3 py-2 font-semibold">Reason</th>
                <th class="px-3 py-2 font-semibold">Date</th>
                <th class="px-3 py-2 font-semibold">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for report in reports %}
            <tr id="report-{{ report.id }}" class="border-t border-line">
                <td class="px-3 py-2">{{ report.phone or "-" }}</td>
                <td class="max-w-[180px] truncate px-3 py-2">{{ report.link or "-" }}</td>
                <td class="max-w-[180px] truncate px-3 py-2">{{ report.reason or "-" }}</td>
                <td class="px-3 py-2">{{ report.created_at[:16] if report.created_at else "-" }}</td>
                <td class="px-3 py-2">
                    <div class="flex flex-wrap gap-2">
                        <button
                            type="button"
                            class="rounded-lg bg-mint/15 px-3 py-1.5 text-xs font-semibold text-mint"
                            onclick="editReport('{{ report.id }}')"
                        >
                            Edit
                        </button>
                        <button
                            type="button"
                            class="rounded-lg bg-rose-500/15 px-3 py-1.5 text-xs font-semibold text-rose-300"
                            onclick="deleteReport('{{ report.id }}')"
                        >
                            Delete
                        </button>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<p class="text-mute">No report history found.</p>
{% endif %}

<div id="reportResponse" class="mt-3 text-sm"></div>

<script>
    function editReport(id) {
        window.location.href = "/report-userhistory-edit/" + id;
    }

    function deleteReport(id) {
        if (!confirm("Are you sure you want to delete this report?")) {
            return;
        }

        $.ajax({
            url: "/report-userhistory-delete/" + id,
            type: "POST",
            success: function(response) {
                if (response.success) {
                    $("#report-" + id).remove();
                    $("#reportResponse").html(
                        "<p class='text-emerald-400'>" + response.message + "</p>"
                    );
                }
            },
            error: function(xhr) {
                let message = "Something went wrong.";
                if (xhr.responseJSON) {
                    message = xhr.responseJSON.message || message;
                }
                $("#reportResponse").html(
                    "<p class='text-rose-400'>" + message + "</p>"
                );
            }
        });
    }
</script>