<div class="space-y-4">
    <!-- Header -->
    <div class="flex items-center justify-between pb-3 border-b border-dark-border/60">
        <h3 class="text-sm sm:text-base font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-bullhorn text-amber-400"></i> Scam Report Submissions
        </h3>
        {% if reports %}
            <span class="px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-bold font-mono">
                {{ reports|length }} Reports Found
            </span>
        {% endif %}
    </div>

    {% if reports and reports|length > 0 %}
    <div class="rounded-2xl border border-dark-border bg-dark-card overflow-hidden shadow-lg">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[650px]">
                <thead>
                    <tr class="border-b border-dark-border bg-dark-cardLight/60 text-[11px] uppercase tracking-wider font-bold text-slate-400">
                        <th class="py-3 px-4">Phone Number</th>
                        <th class="py-3 px-4">Scam Link / URL</th>
                        <th class="py-3 px-4">Reason / Details</th>
                        <th class="py-3 px-4">Reported Date</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-dark-border/60 text-xs">
                    {% for report in reports %}
                    <tr id="report-{{ report.id }}" class="hover:bg-dark-hover/40 transition">
                        
                        <!-- Phone -->
                        <td class="py-3.5 px-4 font-mono text-slate-300 text-[11px] whitespace-nowrap">
                            {% if report.phone %}
                                <span class="px-2 py-0.5 rounded bg-dark-cardLight border border-dark-border text-slate-200">
                                    <i class="fa-solid fa-phone text-amber-400 text-[9px] mr-1"></i> {{ report.phone }}
                                </span>
                            {% else %}
                                <span class="text-slate-600">-</span>
                            {% endif %}
                        </td>

                        <!-- Link -->
                        <td class="py-3.5 px-4 max-w-[180px] truncate">
                            {% if report.link %}
                                <a href="{{ report.link }}" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 truncate block hover:underline" title="{{ report.link }}">
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[9px] mr-1"></i> {{ report.link }}
                                </a>
                            {% else %}
                                <span class="text-slate-600">-</span>
                            {% endif %}
                        </td>

                        <!-- Reason -->
                        <td class="py-3.5 px-4 max-w-[220px] truncate text-slate-300" title="{{ report.reason }}">
                            {{ report.reason or "-" }}
                        </td>

                        <!-- Date -->
                        <td class="py-3.5 px-4 text-slate-400 text-[11px] font-mono whitespace-nowrap">
                            {{ report.created_at[:16] if report.created_at else "-" }}
                        </td>

                        <!-- Action Buttons -->
                        <td class="py-3.5 px-4 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-1.5">
                                <button
                                    type="button"
                                    class="px-2.5 py-1.5 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 hover:bg-blue-600 hover:text-white text-xs font-semibold transition"
                                    onclick="editReport('{{ report.id }}')"
                                >
                                    <i class="fa-solid fa-pen text-[10px] mr-1"></i> Edit
                                </button>
                                <button
                                    type="button"
                                    class="px-2.5 py-1.5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 hover:bg-rose-500 hover:text-white text-xs font-semibold transition"
                                    onclick="deleteReport('{{ report.id }}')"
                                >
                                    <i class="fa-solid fa-trash text-[10px] mr-1"></i> Delete
                                </button>
                            </div>
                        </td>

                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% else %}
    <!-- Empty State -->
    <div class="p-8 rounded-2xl bg-dark-cardLight/50 border border-dark-border text-center space-y-2">
        <i class="fa-regular fa-flag text-2xl text-slate-500"></i>
        <p class="text-xs text-slate-400 font-medium">No scam report submissions found for this user.</p>
    </div>
    {% endif %}

    <!-- AJAX Alert Response -->
    <div id="reportResponse" class="transition-all duration-300"></div>
</div>

<script>
    function editReport(id) {
        window.location.href = "/report-userhistory-edit/" + id;
    }

    function deleteReport(id) {
        if (!confirm("Are you sure you want to delete this scam report? This action cannot be undone.")) {
            return;
        }

        $.ajax({
            url: "/report-userhistory-delete/" + id,
            type: "POST",
            success: function(response) {
                if (response.success) {
                    $("#report-" + id).fadeOut(300, function() {
                        $(this).remove();
                    });
                    $("#reportResponse").html(`
                        <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center gap-2">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>${response.message || "Report deleted successfully."}</span>
                        </div>
                    `);
                }
            },
            error: function(xhr) {
                let message = "Something went wrong while deleting.";
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }
                $("#reportResponse").html(`
                    <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>${message}</span>
                    </div>
                `);
            }
        });
    }
</script>